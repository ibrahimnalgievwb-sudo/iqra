function onOpen() {
  const ui = SpreadsheetApp.getUi();
  ui.createMenu('Управление ВОР')
    .addItem('1. Сгенерировать таблицы (НВК, НСС, ЭС)', 'generateTables')
    .addItem('2. Записать недельный прогресс', 'recordWeeklyProgress')
    .addToUi();
}

// ==============================================================================
// БЛОК 3: ГЕНЕРАЦИЯ И ВЕРСТКА ТАБЛИЦ
// ==============================================================================

function generateTables() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const todayStr = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd.MM.yyyy HH:mm');
  
  for (const sheetName in SHEETS_DATA) {
    let sheet = ss.getSheetByName(sheetName) || ss.insertSheet(sheetName);
    
    // Очистка, снятие фильтров и защит
    sheet.clear(); 
    sheet.clearFormats();
    if (sheet.getFilter()) sheet.getFilter().remove();
    
    const protections = sheet.getProtections(SpreadsheetApp.ProtectionType.SHEET);
    for (let i = 0; i < protections.length; i++) protections[i].remove();

    sheet.setFrozenRows(0); 
    sheet.setFrozenColumns(0);
    sheet.setHiddenGridlines(true); 
    
    let allRows = [];
    
    // Строка 1: Сроки
    allRows.push([`Сроки: 23.11.2026 – 07.01.2027 (45 дн.) | Версия от ${todayStr}`, '', '', '', '', '', '', '', '', '', '', '', '']);
    // Строка 2: Пустая
    allRows.push(['', '', '', '', '', '', '', '', '', '', '', '', '']);
    
    // Строка 3: Шапка
    allRows.push([
      '№ п/п', 'Виды Работ', 'Ед. изм.', 'Кол-во (Проект)', 'Кол-во (Факт)', 
      'Материалы', '', 'Работы', '', 
      'Всего (по проекту)', 'Всего (по факту)', '% выполнения', 'Примечания'
    ]);
    // Строка 4: Подзаголовки
    allRows.push([
      '', '', '', '', '', 
      'Цена за ед.', 'Итого по факту', 'Цена за ед.', 'Итого по факту', 
      '', '', '', ''
    ]);
    
    const data = SHEETS_DATA[sheetName];
    
    // Строка 5: МАТЕРИАЛЫ
    allRows.push(['', 'МАТЕРИАЛЫ', '', '', '', '', '', '', '', '', '', '', '']);
    
    let currentRow = allRows.length + 1; // Данные с 6-й строки
    
    data.materials.forEach((item, index) => {
      allRows.push([
        index + 1, item.name, item.unit, item.qty, 0, 
        item.price || 0, `=E${currentRow}*F${currentRow}`, 
        0, `=E${currentRow}*H${currentRow}`, 
        `=D${currentRow}*(F${currentRow}+H${currentRow})`, 
        `=G${currentRow}+I${currentRow}`, 
        `=IF(D${currentRow}=0;0;E${currentRow}/D${currentRow})`, 
        '' 
      ]);
      currentRow++;
    });
    
    // Раздел РАБОТЫ
    allRows.push(['', 'РАБОТЫ', '', '', '', '', '', '', '', '', '', '', '']);
    currentRow++;
    
    data.works.forEach((item, index) => {
      allRows.push([
        index + 1, item.name, item.unit, item.qty, 0, 
        0, `=E${currentRow}*F${currentRow}`, 
        item.price || 0, `=E${currentRow}*H${currentRow}`, 
        `=D${currentRow}*(F${currentRow}+H${currentRow})`, 
        `=G${currentRow}+I${currentRow}`, 
        `=IF(D${currentRow}=0;0;E${currentRow}/D${currentRow})`, 
        '' 
      ]);
      currentRow++;
    });
    
    // Итоги
    const totalRow = currentRow;
    allRows.push([
      '', 'ИТОГО ПО СМЕТЕ', '', '', '', 
      '', `=SUM(G6:G${totalRow-1})`, 
      '', `=SUM(I6:I${totalRow-1})`, 
      `=SUM(J6:J${totalRow-1})`, 
      `=SUM(K6:K${totalRow-1})`, 
      `=IF(J${totalRow}=0;0;K${totalRow}/J${totalRow})`, 
      ''
    ]);
    
    // Записываем данные БЕЗ объединений
    sheet.getRange(1, 1, allRows.length, 13).setValues(allRows);
    
    // ВЕРСТКА
    // 1. Строка со сроками
    sheet.getRange('A1:M1').merge();
    
    // 2. Объединения в шапке
    sheet.getRange('A3:A4').merge();
    sheet.getRange('B3:B4').merge();
    sheet.getRange('C3:C4').merge();
    sheet.getRange('D3:D4').merge();
    sheet.getRange('E3:E4').merge();
    sheet.getRange('F3:G3').merge();
    sheet.getRange('H3:I3').merge();
    sheet.getRange('J3:J4').merge();
    sheet.getRange('K3:K4').merge();
    sheet.getRange('L3:L4').merge();
    sheet.getRange('M3:M4').merge();
    
    // 3. Границы
    const fullRange = sheet.getRange(3, 1, totalRow - 2, 13);
    fullRange.setBorder(true, true, true, true, true, true, '#000000', SpreadsheetApp.BorderStyle.SOLID);
    fullRange.setBorder(true, true, true, true, null, null, '#000000', SpreadsheetApp.BorderStyle.SOLID_MEDIUM);
    
    // 4. Форматы чисел
    const numFmtRange = sheet.getRange(6, 4, totalRow - 5, 9); // D:K
    numFmtRange.setNumberFormat('#,##0.00').setFontFamily('Roboto Mono').setHorizontalAlignment('right');
    
    sheet.getRange(6, 12, totalRow - 5, 1)
         .setNumberFormat('0.00%')
         .setFontFamily('Roboto Mono')
         .setHorizontalAlignment('center')
         .setFontWeight('bold');
         
    sheet.getRange(6, 4, totalRow - 5, 2).setNumberFormat('0.###').setHorizontalAlignment('center').setFontFamily('Arial');
    
    // 5. Выравнивание
    sheet.getRange(3, 1, 2, 13).setHorizontalAlignment('center').setVerticalAlignment('middle').setFontWeight('bold').setWrap(true);
    sheet.getRange(6, 1, totalRow - 5, 1).setHorizontalAlignment('center').setVerticalAlignment('middle'); 
    sheet.getRange(6, 3, totalRow - 5, 1).setHorizontalAlignment('center').setVerticalAlignment('middle'); 
    sheet.getRange(6, 2, totalRow - 5, 1).setVerticalAlignment('middle').setWrap(true);
    
    // 6. Цвета
    sheet.getRange('A1:M1').setBackground('#F4B183').setFontWeight('bold').setFontFamily('Arial'); 
    sheet.getRange(3, 1, 2, 13).setBackground('#C6E0B4').setFontFamily('Arial'); 
    sheet.getRange(5, 1, 1, 13).setBackground('#8EA9DB').setFontColor('#FFFFFF').setFontWeight('bold').setFontFamily('Arial');
    sheet.getRange(totalRow - data.works.length, 1, 1, 13).setBackground('#8EA9DB').setFontColor('#FFFFFF').setFontWeight('bold').setFontFamily('Arial');
    sheet.getRange(totalRow, 1, 1, 13).setBackground('#FFD966').setFontWeight('bold').setFontFamily('Arial');
    
    sheet.getRange(6, 5, totalRow - 5, 1).setBackground('#FFF9E6');
    
    // «Зебра»
    const materialsEndRow = 5 + data.materials.length;
    const worksStartRow = materialsEndRow + 1;
    const worksEndRow = worksStartRow + data.works.length - 1;
    
    for (let r = 6; r <= worksEndRow; r++) {
      if (r % 2 === 0) {
        sheet.getRange(r, 1, 1, 13).setBackground('#F8F9FA');
      }
    }
    
    // 7. Ширина колонок
    sheet.setColumnWidth(1, 45);  
    sheet.setColumnWidth(2, 380); 
    sheet.setColumnWidth(3, 60);  
    sheet.setColumnWidth(4, 75);  
    sheet.setColumnWidth(5, 75);  
    sheet.setColumnWidth(6, 95); 
    sheet.setColumnWidth(7, 105); 
    sheet.setColumnWidth(8, 95); 
    sheet.setColumnWidth(9, 105); 
    sheet.setColumnWidth(10, 115); 
    sheet.setColumnWidth(11, 115); 
    sheet.setColumnWidth(12, 85); 
    sheet.setColumnWidth(13, 140); 
    
    // 8. Высота строк
    sheet.setRowHeight(1, 30);
    sheet.setRowHeight(3, 30);
    sheet.setRowHeight(4, 30);
    sheet.setRowHeights(6, totalRow - 5, 40);
    
    // 9. Закрепление и удаление пустых строк
    sheet.setFrozenRows(4);
    if (sheet.getMaxRows() > totalRow + 15) {
      sheet.deleteRows(totalRow + 15, sheet.getMaxRows() - (totalRow + 15));
    }
    
    // 10. УСЛОВНОЕ ФОРМАТИРОВАНИЕ ДЛЯ %
    const pctRange = sheet.getRange(6, 12, totalRow - 5, 1);
    
    let rule1 = SpreadsheetApp.newConditionalFormatRule()
      .whenNumberLessThan(0.5)
      .setBackground('#F4CCCC')
      .setFontColor('#990000')
      .setRanges([pctRange])
      .build();
      
    let rule2 = SpreadsheetApp.newConditionalFormatRule()
      .whenNumberBetween(0.5, 0.99)
      .setBackground('#FFF2CC')
      .setFontColor('#B45F06')
      .setRanges([pctRange])
      .build();
      
    let rule3 = SpreadsheetApp.newConditionalFormatRule()
      .whenNumberGreaterThanOrEqualTo(1)
      .setBackground('#D9EAD3')
      .setFontColor('#274E13')
      .setRanges([pctRange])
      .build();
      
    const rules = sheet.getConditionalFormatRules();
    rules.push(rule1, rule2, rule3);
    sheet.setConditionalFormatRules(rules);

    // 11. ЗАЩИТА ФОРМУЛ
    const formulaRange = sheet.getRange(6, 6, totalRow - 5, 4); 
    const totalRange = sheet.getRange(6, 10, totalRow - 5, 3);  
    
    let protection = formulaRange.protect().setDescription('Защита формул: Материалы и Работы');
    protection.setWarningOnly(true); 
    
    let protection2 = totalRange.protect().setDescription('Защита формул: Итоги и %');
    protection2.setWarningOnly(true);
    
    // 12. Блок учета недель
    const weekRow = totalRow + 4;
    sheet.getRange(weekRow, 1, 1, 4).setValues([['Неделя', 'Проценты за прошлые недели выполнения', 'Разница в %', 'Итоговое выполнение по ДС в финансовом %']])
      .setFontWeight('bold').setBackground('#FFE699').setBorder(true, true, true, true, true, true, '#000000', SpreadsheetApp.BorderStyle.SOLID_MEDIUM).setHorizontalAlignment('center').setWrap(true).setFontFamily('Arial');
    sheet.setRowHeight(weekRow, 40);
    
    sheet.getRange(weekRow + 1, 1).setValue('Текущий статус:').setFontWeight('bold').setBorder(true, true, true, true, true, true).setHorizontalAlignment('right').setFontFamily('Arial');
    sheet.getRange(weekRow + 1, 2, 1, 2).setBorder(true, true, true, true, true, true);
    sheet.getRange(weekRow + 1, 4).setFormula(`=L${totalRow}`).setNumberFormat('0.00%').setFontWeight('bold').setFontColor('#C00000').setFontSize(12).setBorder(true, true, true, true, true, true).setHorizontalAlignment('center').setFontFamily('Roboto Mono');
  }
  
  SpreadsheetApp.getUi().alert('Готово! Таблицы успешно сгенерированы.\n\nВводите фактическое количество в столбец "Кол-во (Факт)" (он выделен бежевым), и таблица сама посчитает суммы и проценты.');
}

// ==============================================================================
// БЛОК 4: УЧЕТ НЕДЕЛЬНОГО ПРОГРЕССА
// ==============================================================================

function recordWeeklyProgress() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const props = PropertiesService.getDocumentProperties(); 
  
  const today = new Date();
  const lastMonday = new Date(today);
  lastMonday.setDate(today.getDate() - ((today.getDay() + 6) % 7 || 7));
  lastMonday.setHours(0, 0, 0, 0);
  const targetDateStr = Utilities.formatDate(lastMonday, Session.getScriptTimeZone(), 'dd.MM.yyyy');

  const sheets = ['НВК', 'НСС', 'ЭС'];
  let successCount = 0;
  let errorMessages = [];
  
  sheets.forEach(sheetName => {
    const sheet = ss.getSheetByName(sheetName);
    if (!sheet) {
      errorMessages.push(`Лист "${sheetName}" не найден.`);
      return;
    }

    let totalPercentCell = null;
    let weekHeaderRow = -1;
    const lastRow = sheet.getLastRow();
    
    if (lastRow > 0) {
      const colAValues = sheet.getRange(1, 1, lastRow, 1).getDisplayValues().flat();
      for (let i = 0; i < colAValues.length; i++) {
        if (colAValues[i].trim() === 'Неделя') weekHeaderRow = i + 1;
        if (colAValues[i].trim() === 'Текущий статус:') totalPercentCell = sheet.getRange(i + 1, 4).getValue(); 
      }
    }

    if (weekHeaderRow === -1 || totalPercentCell === null) {
      errorMessages.push(`На листе "${sheetName}" не найден блок "Неделя". Запустите "1. Сгенерировать таблицы".`);
      return;
    }

    const propKey = `VESTA_STORED_${sheetName}`; 
    const storedPercent = props.getProperty(propKey);
    
    const historyStartRow = weekHeaderRow + 1;
    let rowToWrite = historyStartRow;
    
    while (rowToWrite <= sheet.getLastRow() && sheet.getRange(rowToWrite, 1).getDisplayValue().trim() !== '') {
      rowToWrite++;
    }

    if (storedPercent !== null) {
      const val = parseFloat(storedPercent);
      let historyExists = false;
      
      if (rowToWrite > historyStartRow) {
        const numHistoryRows = rowToWrite - historyStartRow;
        const historyDates = sheet.getRange(historyStartRow, 1, numHistoryRows, 1).getDisplayValues().flat().map(d => d.trim());
        if (historyDates.includes(targetDateStr)) historyExists = true;
      }

      if (!historyExists) {
        const diffFormula = (rowToWrite > historyStartRow) ? `=B${rowToWrite}-B${rowToWrite-1}` : 0;
        sheet.getRange(rowToWrite, 1, 1, 4).setValues([[targetDateStr, val, diffFormula, totalPercentCell]]);
        sheet.getRange(rowToWrite, 1, 1, 4).setNumberFormat('0.00%');
        sheet.getRange(rowToWrite, 1, 1, 4).setBorder(true, true, true, true, true, true);
        sheet.getRange(rowToWrite, 1, 1, 1).setHorizontalAlignment('center');
        
        console.log(`[${sheetName}] Записано: ${targetDateStr} -> ${val}`);
        successCount++;
      }
    } else {
       console.log(`[${sheetName}] Первый запуск, сохраняем базовый процент ${totalPercentCell}`);
    }

    props.setProperty(propKey, totalPercentCell);
  });

  let msg = '';
  if (successCount > 0) msg += `✅ Успешно записано для ${successCount} листов.\n`;
  if (errorMessages.length > 0) msg += `⚠️ Предупреждения:\n- ` + errorMessages.join('\n- ');
  if (msg === '') msg = 'Нет новых данных для записи.';
  
  SpreadsheetApp.getUi().alert(msg);
}
